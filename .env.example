# Telegram bot token: message @BotFather, send /newbot, copy the token
TELEGRAM_TOKEN=

# AnimeAPI key (starts with ank_): https://animeapi.ai/dashboard/api-keys
ANIMEAPI_KEY=

# Optional settings (these are the defaults)
ANIMEAPI_MODEL=anime
ANIMEAPI_ORIENTATION=portrait
ALLOW_NSFW=false
COOLDOWN_SECONDS=30
